# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
NEXT_PUBLIC_MODO_DEMONSTRACAO=false
NEXT_PUBLIC_URL_DA_APLICACAO=http://localhost:5173
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-chave-publishable-aqui

# Somente scripts administrativos locais podem usar a service_role.
# Nunca exponha esta chave no navegador nem a envie para o Git.
SUPABASE_SERVICE_ROLE_KEY=
